{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","createdUtc","gitSha","workingTree","sourceHashes","fontHashes","windows","sdk","dpi","viewports","pageZoom","dpiRoute","actualWindowsBothDpiValidated","fixtureCount","rendererExecutableSha256"],
  "properties":{
    "schemaVersion":{"const":1},"createdUtc":{"type":"string"},"gitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "workingTree":{"type":"string"},"sourceHashes":{"type":"array"},"fontHashes":{"type":"array"},
    "windows":{"type":"string"},"sdk":{"type":"string"},"dpi":{"type":"array","items":{"enum":[96,144]}},
    "viewports":{"type":"array","items":{"type":"string","pattern":"^[0-9]+x[0-9]+$"}},
    "pageZoom":{"const":1.0},"dpiRoute":{"const":"explicit-dpi-view-paint"},
    "actualWindowsBothDpiValidated":{"type":"boolean"},"fixtureCount":{"type":"integer","minimum":1},
    "rendererExecutableSha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "runtimeHashes":{"type":"array","items":{"type":"object","required":["file","sha256"],"properties":{"file":{"type":"string"},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}},
    "rasterBackend":{"type":"string"},
    "enumeratedGraphicsAdapters":{"type":"array","items":{"type":"object","required":["name","driverVersion","deviceId"],"properties":{"name":{"type":"string"},"driverVersion":{"type":["string","null"]},"deviceId":{"type":["string","null"]}}}},
    "selectedGraphicsAdaptersRecorded":{"type":"boolean"}
  }
}
