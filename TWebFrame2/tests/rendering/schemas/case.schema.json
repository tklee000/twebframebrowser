{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schemaVersion","id","stage","family","features","seed","generatorVersion","scriptless","states","viewports","dpi","htmlSha256","cssSha256"],
  "properties":{
    "schemaVersion":{"const":1},
    "id":{"type":"string","pattern":"^[0-9]{4}-[a-z0-9-]+$"},
    "stage":{"type":"string"},
    "family":{"enum":["cascade","block","text","flex","grid","table","position","paint","responsive","integration"]},
    "features":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "seed":{"type":"integer"},"generatorVersion":{"type":"string"},"scriptless":{"const":true},
    "states":{"type":"array","minItems":1,"items":{"type":"string"}},
    "viewports":{"type":"array","items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}}},
    "dpi":{"type":"array","uniqueItems":true,"items":{"enum":[96,144]}},
    "htmlSha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "cssSha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}
  }
}
